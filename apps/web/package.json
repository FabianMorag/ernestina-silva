{
  "name": "@ernestina-silva/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
